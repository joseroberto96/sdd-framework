{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    ".agent/adapters/opencode.md"
  ],
  "permission": {
    "skill": {
      "source-command-*": "deny"
    },
    "bash": {
      "*db push*": "ask",
      "*db:push*": "ask",
      "*drizzle-kit push*": "ask",
      "*supabase db reset*": "ask",
      "*prisma migrate reset*": "ask",
      "*DROP TABLE*": "ask",
      "*DROP DATABASE*": "ask",
      "*TRUNCATE*": "ask",
      "*migrate*--force*": "ask",
      "*git push*--force*": "ask",
      "*git push -f*": "ask",
      "*git push*--mirror*": "ask",
      "*git push*--delete*": "ask",
      "*git push -d *": "ask",
      "*git push * +*": "ask",
      "*git push * :*": "ask",
      "rm -rf /*": "ask",
      "rm -rf ~*": "ask"
    }
  },
  "mcp": {
    "state_manager": {
      "type": "local",
      "command": ["python3", ".agent/scripts/state_manager.py"],
      "enabled": true
    }
  }
}
