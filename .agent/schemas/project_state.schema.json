{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-v3.local/schemas/project_state.schema.json",
  "title": "Framework Project State",
  "type": "object",
  "required": [
    "project",
    "framework_mode",
    "framework_version",
    "current_phase",
    "current_step",
    "last_completed_step",
    "stack",
    "dependencies",
    "architecture_constraints",
    "contracts",
    "modules",
    "module_statuses",
    "work_tiers",
    "module_specs",
    "closure_rejections",
    "active_mcps",
    "_refs"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "framework_mode": {
      "enum": [
        "template",
        "initialized"
      ]
    },
    "framework_version": {
      "type": "string"
    },
    "current_phase": {
      "type": "string",
      "pattern": "^phase_[0-9]{2}$"
    },
    "current_step": {
      "type": "string"
    },
    "last_completed_step": {
      "type": "string"
    },
    "stack": {
      "type": "object",
      "required": [
        "backend",
        "frontend",
        "database",
        "auth"
      ],
      "properties": {
        "backend": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "object",
      "required": [
        "public_interfaces"
      ],
      "properties": {
        "public_interfaces": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "object",
      "required": [
        "completed",
        "in_progress",
        "pending"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "in_progress": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dropped": {
          "type": "array",
          "description": "PA-FW-037 (5.3.3): módulos abandonados (estado terminal dropped). Opcional; solo lo escribe abandon_module.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "module_abandonments": {
      "type": "object",
      "description": "PA-FW-037 (5.3.3): rastro de cada abandon_module (opcional).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from_status",
          "reason",
          "evidence",
          "abandoned_at"
        ],
        "properties": {
          "from_status": {
            "enum": [
              "not_started",
              "in_progress",
              "blocked",
              "ready_for_validation"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "abandoned_at": {
            "type": "string"
          }
        }
      }
    },
    "module_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "not_started",
          "in_progress",
          "blocked",
          "ready_for_validation",
          "completed",
          "dropped"
        ]
      }
    },
    "work_tiers": {
      "type": "object",
      "description": "Clasificación de rigor por unidad de trabajo. Claves recomendadas: module_id o identificador estable de tarea.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tier",
          "rationale",
          "classified_at",
          "classified_by"
        ],
        "properties": {
          "tier": {
            "enum": [
              "tier_0",
              "tier_1",
              "tier_2"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "classified_at": {
            "type": "string"
          },
          "classified_by": {
            "type": "string"
          },
          "promotion_from": {
            "enum": [
              "tier_0",
              "tier_1",
              "tier_2"
            ]
          },
          "requires_second_review": {
            "type": "boolean"
          },
          "handles_real_data": {
            "type": "boolean",
            "description": "FW-083: true si el módulo persiste o escribe datos reales/PII (GUARDRAILS: 'toca PII más allá de leerla'). Se declara en add_work_tier, mismo momento que tier/rationale."
          },
          "data_safety": {
            "type": "object",
            "description": "FW-083: sello de verificación de seguridad de datos. Exigido por el cierre cuando handles_real_data=true. Escrito por record_data_safety_check.",
            "required": ["target_env", "backup_verified", "evidence", "recorded_at"],
            "properties": {
              "target_env": {
                "enum": ["dev", "staging", "prod"]
              },
              "backup_verified": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              },
              "recorded_by": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "builder_use": {
            "type": "object",
            "description": "FW-275 (5.2.2): uso real confirmado por el builder con confirm_builder_use. No es requisito de cierre; una segunda confirmación añade evidencia.",
            "required": ["confirmed_at", "confirmed_by", "evidence"],
            "properties": {
              "confirmed_at": {
                "type": "string"
              },
              "confirmed_by": {
                "const": "builder"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "confirmed_at"]
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "module_specs": {
      "type": "object",
      "description": "Clasificación de specs formales por módulo (ADR-013). Claves: module_id en project_state.json.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_model",
          "api_contract",
          "classified_at",
          "classified_by"
        ],
        "properties": {
          "data_model": {
            "enum": [
              "required",
              "n/a",
              "done"
            ]
          },
          "api_contract": {
            "enum": [
              "required",
              "n/a",
              "done"
            ]
          },
          "justification": {
            "type": "string",
            "description": "Razón obligatoria cuando data_model o api_contract son 'n/a'."
          },
          "classified_at": {
            "type": "string",
            "description": "Timestamp ISO8601."
          },
          "classified_by": {
            "enum": [
              "scope-siguiente",
              "enriquecer-ticket",
              "migrar-proyecto",
              "manual"
            ],
            "description": "/cierre-modulo solo transiciona required→done, no clasifica."
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "data_model": {
                      "const": "n/a"
                    }
                  },
                  "required": [
                    "data_model"
                  ]
                },
                {
                  "properties": {
                    "api_contract": {
                      "const": "n/a"
                    }
                  },
                  "required": [
                    "api_contract"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "justification"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "closure_rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "reason",
          "timestamp"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "critical_bug_exists",
              "clar_pending",
              "ac_incomplete",
              "ac_evidence_missing",
              "module_specs_missing",
              "data_model_missing",
              "api_contract_missing",
              "data_safety_missing",
              "domain_sweep_missing",
              "expert_audit_missing"
            ]
          },
          "timestamp": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "active_mcps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_profile": {
      "type": "object",
      "description": "Capacidad del modelo que ejecuta el framework (segundo eje de rigor). Opcional; cuando capability_tier='limited', validate_closure exige requires_second_review en todo tier.",
      "required": [
        "capability_tier"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Identificador libre del modelo, p. ej. 'claude-haiku-4-5' o 'gpt-5-codex'."
        },
        "capability_tier": {
          "enum": [
            "strong",
            "standard",
            "limited"
          ],
          "description": "Agnóstico del proveedor. El framework no fija el mapa modelo→tier."
        },
        "rationale": {
          "type": "string"
        },
        "declared_at": {
          "type": "string",
          "description": "Timestamp ISO8601."
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "description": "FW-225: ciclo de vida del producto. Opcional; ausente = development. Solo el builder lo cambia (set_lifecycle con builder_confirmed).",
      "required": ["stage"],
      "properties": {
        "stage": { "enum": ["development", "production"] },
        "set_at": { "type": "string" },
        "set_by": { "type": "string" },
        "reason": { "type": "string" },
        "escalation_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Patrones glob adicionales que obligan a escalar un cambio a módulo."
        }
      },
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "description": "FW-225: cambios de mantenimiento (open_change/close_change/escalate_change).",
      "items": {
        "type": "object",
        "required": ["id", "summary", "tier", "criteria", "status", "opened_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^CHG-[0-9]{3,}$" },
          "summary": { "type": "string" },
          "tier": { "enum": ["tier_0", "tier_1"] },
          "criteria": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
          "affected_modules": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["open", "closed", "escalated"] },
          "opened_at": { "type": "string" },
          "closed_at": { "type": "string" },
          "evidence": { "type": "object" },
          "tests": { "type": "string" },
          "changelog": { "type": "string" },
          "escalated_to": { "type": "string" },
          "escalation_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "_bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module_id",
          "severity",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BUG-[0-9]{3}$"
          },
          "module_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "Crítico",
              "Mayor",
              "Menor"
            ]
          },
          "description": {
            "type": "string"
          },
          "affects_ac": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "Abierto",
              "Resuelto",
              "Deuda Técnica"
            ]
          },
          "fix": {
            "type": "string"
          },
          "affected_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          },
          "resolved_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "_clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocked_scope",
          "question",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLAR-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "blocked_scope": {
            "type": "string"
          },
          "blocks_start": {
            "type": "boolean"
          },
          "blocks_implementation": {
            "type": "boolean"
          },
          "blocks_closure": {
            "type": "boolean"
          },
          "blocking_condition": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Abierta",
              "Resuelta"
            ]
          },
          "answer": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "resolved_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "context",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "module_id": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "alternatives": {
            "type": "string"
          },
          "consequences": {
            "type": "string"
          },
          "expertise": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "workflow_receipts": {
      "type": "object",
      "description": "Recibos mecánicos de aprobación y revisión independiente (ADR-054).",
      "properties": {
        "approvals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "module", "tier", "approved_by", "approval_evidence", "risk_summary", "adr_refs", "basis", "fingerprint"],
            "additionalProperties": true
          }
        },
        "reviews": {
          "type": "object",
          "description": "Historial append-only por módulo (FW-165): cada ronda de revisión independiente es una entrada; el gate de cierre mira la última.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["status", "module", "reviewer_id", "implementer_id", "mode", "diff_hash", "started_at"],
              "additionalProperties": true
            }
          }
        },
        "executions": {
          "type": "object",
          "description": "FW-144: recibo del EJECUTABLE GATE (verificar-ejecutable, cierre-modulo paso 3.8). additionalProperties:false del objeto padre estaba desincronizado con workflow_receipts.py::_receipts() desde su creación — el motor ya escribía esta familia en runtime sin que el schema la declarara.",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "module", "kind", "evidence", "diff_hash", "recorded_at"],
            "additionalProperties": true
          }
        },
        "checkpoints": {
          "type": "object",
          "description": "FW-134: recibos mecánicos de obligaciones endurecidas en prosa (FW-131 barrido de sub-dominios, FW-132 auditoría de experto). Declarar, no encontrar — mismo contrato que harvest. Keyed por kind, luego por scope_id.",
          "additionalProperties": {
            "type": "object",
            "description": "Por kind: domain_sweep | expert_audit. Clave interna: scope_id.",
            "additionalProperties": {
              "type": "object",
              "required": ["kind", "scope_id", "evidence", "reference", "recorded_at"],
              "properties": {
                "kind": {"enum": ["domain_sweep", "expert_audit"]},
                "scope_id": {"type": "string"},
                "evidence": {"type": "string"},
                "reference": {
                  "type": "string",
                  "description": "Cita concreta: fila de 09_domain_profile.md, o referencia al experto/AC correspondiente."
                },
                "recorded_by": {"type": "string"},
                "recorded_at": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        }
      },
      "additionalProperties": false
    },
    "framework_migrations": {
      "type": "object",
      "description": "Migraciones de framework ejecutadas; no contiene ejecuciones Codex.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "status", "archive_path", "archive_sha256"],
        "properties": {
          "type": {"const": "codex_budget_retirement"},
          "status": {"enum": ["applied", "reverted"]},
          "archive_path": {"type": "string"},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_fingerprint": {"type": "string"},
          "applied_at": {"type": "string"},
          "reverted_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "next_action": {
          "type": "string"
        },
        "next_command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\r\\n])(?!.*\\s[-–—]\\s)(?:ninguno|/[^\\r\\n—–]+)$"
        },
        "active_module_description": {
          "type": "string"
        },
        "next_module": {
          "type": "string"
        }
      },
      "not": {"required": ["codex_execution"]},
      "additionalProperties": true
    },
    "active_focus": {
      "type": [
        "string",
        "null"
      ],
      "description": "Área en la que el builder pidió profundizar (3.12.0). Opcional: proyectos sin el campo siguen validando. Valores típicos: 'frontend' | 'backend' | 'data' | 'seguridad' | 'testing' | null. null limpia el foco. La proyección de core.md muestra 'sin foco' cuando el campo no existe o es null."
    }
  },
  "additionalProperties": true
}
